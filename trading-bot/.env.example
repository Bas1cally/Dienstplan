# Niemals die echte Datei (.env) committen!
# Empfehlung: Auf Hyperliquid einen API-Wallet ("agent wallet") erzeugen und
# dessen Private Key hier eintragen - nicht den Key des Haupt-Wallets.
HL_PRIVATE_KEY=0x...
# Adresse des Haupt-Accounts (auf dem die Margin liegt)
HL_ACCOUNT_ADDRESS=0x...

# Optional: News-Quellen (siehe config.yaml -> news)
# Kostenlos: https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=
# X/Twitter API (kostenpflichtig, nur Polling im Basic-Tier - siehe README)
TWITTER_BEARER_TOKEN=

# Optional: Claude-KI-News-Klassifizierung (config.yaml -> news.llm_enabled)
ANTHROPIC_API_KEY=

# Optional: Telegram-Alerts (RISK_OFF, Rotation, Circuit Breaker, Start/Stop)
# Bot bei @BotFather anlegen; Chat-ID via /getUpdates ermitteln (siehe bot/notify.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Zugriffsschutz fürs Dashboard (Pflicht bei Fernzugriff via
# Tailscale/SSH-Tunnel!). Erzeugen z.B. mit: openssl rand -hex 24
DASHBOARD_TOKEN=

# Optional: Signal-Modus (execution.mode: signals) - POST jedes Order-Tickets
# an einen eigenen Empfänger (z.B. Notification-Service)
SIGNAL_WEBHOOK_URL=

# Optional: Log-Lautstärke in der Konsole (DEBUG | INFO | WARNING)
# WARNING = nur noch Wichtiges (Risiko-Wechsel, Fehler, Circuit Breaker)
LOG_LEVEL=INFO

# Optional: Status-Spiegel fürs Repo (config.yaml -> status_push.enabled: true)
# Fine-grained GitHub PAT, NUR "Contents: Read and write" auf GENAU dieses
# Repo (bas1cally/dienstplan) - kein Zugriff auf andere Repos/Settings nötig.
# Erzeugen: github.com/settings/personal-access-tokens/new
STATUS_PUSH_TOKEN=
